{
  "name": "d2h-dashboard",
  "version": "0.1.7",
  "type": "module",
  "description": "Real-time Android-to-HarmonyOS migration dashboard: zero-dependency local server + static web reading .migration artifacts",
  "bin": {
    "d2h-dashboard": "server/serve.mjs"
  },
  "files": [
    "dist/",
    "server/serve.mjs",
    "server/dataApi.mjs"
  ],
  "scripts": {
    "dev": "vite",
    "dev:data": "node scripts/vite-with-data.mjs dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "preview:data": "node scripts/vite-with-data.mjs preview",
    "serve": "node server/serve.mjs",
    "release": "node scripts/release-to-skill.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "android",
    "harmonyos",
    "arkts",
    "migration",
    "dashboard"
  ]
}
